# Claims Approval System — environment configuration
# Copy this file to .env and fill in your values before running the app.
# .env is gitignored and must NEVER be committed to version control.
#
# Usage:
#   cp .env.example .env
#   then edit .env with your actual credentials

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=claims_db
DB_USER=claims_user
DB_PASS=change_me_to_a_strong_password

# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" on live servers, "development" locally.
APP_ENV=development

# Full public URL of this installation (no trailing slash).
APP_URL=https://claims.rmu.edu.gh

# ── Email (SMTP) — required only to actually send mail ──────────────────────
# If these are blank/absent, the app still works: messages are written to the
# email_queue table and skipped (no delivery). Fill them in to enable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls          # tls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rmu.edu.gh
SMTP_FROM_NAME="RMU Claims System"
SMTP_AUTH=true               # true | false (internal relays may not need auth)
